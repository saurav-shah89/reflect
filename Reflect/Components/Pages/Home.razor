@page "/"
@inject IEntryService EntryService
@inject NavigationManager Navigation
@inject ILogger<Home> Logger

<PageTitle>Today &middot; Reflect</PageTitle>

<ScreenHeader Title="Today" Subtitle="@DateTime.Now.ToString("dddd, d MMMM yyyy")" />

@if (_loadFailure is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        Could not read the journal: @_loadFailure
    </MudAlert>
}
else if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else
{
    <div class="lp-stagger">

        <div class="lp-block mb-8">
            @if (_todaysEntry is null)
            {
                <div class="lp-label mb-2">Today</div>
                <MudText Typo="Typo.h5">Nothing written yet</MudText>
                <MudText Typo="Typo.body2" Class="mt-2 mb-4">
                    You have not made an entry for today.
                </MudText>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Edit"
                           Href="/write"
                           Style="@ActionButtonStyle">Write today's entry</MudButton>
            }
            else
            {
                <div class="lp-label mb-2">Today's entry</div>
                <MudText Typo="Typo.h5">@_todaysEntry.Title</MudText>
                <div class="d-flex align-baseline mt-2 mb-4" style="gap: 8px;">
                    <span class="lp-figure" style="font-size: 30px;">@_todaysEntry.WordCount</span>
                    <span class="lp-label">
                        words &middot; last updated @_todaysEntry.UpdatedAt.ToString("HH:mm")
                    </span>
                </div>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Edit"
                           Href="/write"
                           Style="@ActionButtonStyle">Edit today's entry</MudButton>
            }
        </div>

        <div>
            <div class="lp-label mb-1">Recent entries</div>

            @if (_recent.Count == 0)
            {
                <div class="lp-rule-row">
                    <MudText Typo="Typo.body2">
                        No entries yet. Your journal starts when you write one.
                    </MudText>
                </div>
            }
            else
            {
                @* Ruled rows rather than an icon list: the same row treatment the
                   dashboard uses, and each one opens that day's entry. *@
                @foreach (var entry in _recent)
                {
                    <div class="lp-rule-row entry-card d-flex align-baseline justify-space-between"
                         style="gap: 12px;"
                         role="button"
                         tabindex="0"
                         @onclick="@(() => OpenDate(entry.EntryDate))"
                         @onkeydown="@(e => OnRowKeyDown(e, entry.EntryDate))">
                        @* An entry title is content, so it takes the display face as it
                           does in the timeline, rather than the mono used for chrome. *@
                        <MudText Typo="Typo.body1" Class="lp-display" Style="font-size: 1.12rem;">
                            @entry.Title
                        </MudText>
                        <span class="lp-label" style="white-space: nowrap;">
                            @entry.EntryDate.ToString("d MMM") &middot; @entry.WordCount words
                        </span>
                    </div>
                }
            }

            <div class="d-flex align-baseline mt-5" style="gap: 8px;">
                <span class="lp-figure" style="font-size: 30px;">@_totalEntries</span>
                <span class="lp-label">
                    @(_totalEntries == 1 ? "entry in your journal" : "entries in your journal")
                </span>
            </div>
        </div>
    </div>
}

@code {
    private const int RecentCount = 5;

    /// <summary>The letterpress action button: square, spaced small caps.</summary>
    private const string ActionButtonStyle =
        "border-radius: 0; padding: 11px 18px; font-size: 0.66rem; " +
        "letter-spacing: 0.2em; text-transform: uppercase; font-weight: 600;";

    private JournalEntry? _todaysEntry;
    private IReadOnlyList<JournalEntry> _recent = Array.Empty<JournalEntry>();
    private int _totalEntries;
    private bool _isLoading = true;
    private string? _loadFailure;

    private void OpenDate(DateTime date) => Navigation.NavigateTo($"/write/{date:yyyy-MM-dd}");

    /// <summary>
    /// The rows are divs carrying role="button", so the keyboard activation a real
    /// button would give for free has to be supplied here.
    /// </summary>
    private void OnRowKeyDown(KeyboardEventArgs args, DateTime date)
    {
        if (args.Key is "Enter" or " ")
        {
            OpenDate(date);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _todaysEntry = await EntryService.GetByDateAsync(DateTime.Today);

            var page = await EntryService.SearchAsync(new EntryQuery(), page: 1, pageSize: RecentCount);
            _recent = page.Items;
            _totalEntries = page.TotalCount;
        }
        catch (Exception ex)
        {
            // Surface the failure in the UI rather than leaving a blank screen,
            // and log the detail so it can be diagnosed.
            Logger.LogError(ex, "Failed to load the home page");
            _loadFailure = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
