@page "/"
@inject IEntryService EntryService
@inject NavigationManager Navigation
@inject ILogger<Home> Logger

<PageTitle>Today &middot; Reflect</PageTitle>

<ScreenHeader Title="Today" Subtitle="@DateTime.Now.ToString("dddd, d MMMM yyyy")" />

@if (_loadFailure is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        Could not read the journal: @_loadFailure
    </MudAlert>
}
else if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudCard Class="mb-6">
        <MudCardContent>
            @if (_todaysEntry is null)
            {
                <MudText Typo="Typo.h6">Nothing written yet</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    You have not made an entry for today.
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.h6">@_todaysEntry.Title</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @_todaysEntry.WordCount words &middot;
                    last updated @_todaysEntry.UpdatedAt.ToString("HH:mm")
                </MudText>
            }
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit"
                       Href="/write">
                @(_todaysEntry is null ? "Write today's entry" : "Edit today's entry")
            </MudButton>
        </MudCardActions>
    </MudCard>

    <MudText Typo="Typo.h6" Class="mb-2">Recent entries</MudText>

    @if (_recent.Count == 0)
    {
        <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined">
            No entries yet. Your journal starts when you write one.
        </MudAlert>
    }
    else
    {
        @* Clicking a row opens that day's entry. *@
        <MudPaper Outlined="true">
            <MudList T="string" Class="py-0">
                @foreach (var entry in _recent)
                {
                    <MudListItem T="string" OnClick="@(() => OpenDate(entry.EntryDate))">
                        <div class="d-flex align-center justify-space-between gap-3">
                            <MudText Typo="Typo.body1">@entry.Title</MudText>
                            <MudText Typo="Typo.caption"
                                     Style="white-space: nowrap;" Class="mud-text-secondary">
                                @entry.EntryDate.ToString("d MMM") &middot; @entry.WordCount words
                            </MudText>
                        </div>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    }

    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-4">
        @_totalEntries @(_totalEntries == 1 ? "entry" : "entries") in your journal
    </MudText>
}

@code {
    private const int RecentCount = 5;

    private JournalEntry? _todaysEntry;
    private IReadOnlyList<JournalEntry> _recent = Array.Empty<JournalEntry>();
    private int _totalEntries;
    private bool _isLoading = true;
    private string? _loadFailure;

    private void OpenDate(DateTime date) => Navigation.NavigateTo($"/write/{date:yyyy-MM-dd}");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _todaysEntry = await EntryService.GetByDateAsync(DateTime.Today);

            var page = await EntryService.SearchAsync(new EntryQuery(), page: 1, pageSize: RecentCount);
            _recent = page.Items;
            _totalEntries = page.TotalCount;
        }
        catch (Exception ex)
        {
            // Show something on screen instead of a blank page, and log the
            // details.
            Logger.LogError(ex, "Failed to load the home page");
            _loadFailure = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
