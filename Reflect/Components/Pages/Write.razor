@page "/write"
@page "/write/{DateText}"
@inject IEntryService EntryService
@inject IReferenceDataService ReferenceData
@inject IMarkdownRenderer Markdown
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ILogger<Write> Logger

<PageTitle>@(_isExisting ? "Edit entry" : "New entry") &middot; Reflect</PageTitle>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (_fatalError is not null)
{
    <MudAlert Severity="Severity.Error">@_fatalError</MudAlert>
}
else
{
    <ScreenHeader Title="@(_isExisting ? _date.ToString("dddd") : "Today")"
                  Subtitle="@_date.ToString("d MMMM yyyy")">
        <Actions>
            <span class="lp-label">@_liveWordCount words</span>

            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                           Variant="Variant.Outlined" Size="Size.Small"
                           OnClick="@(() => GoToDate(_date.AddDays(-1)))"
                           title="Previous day" aria-label="Previous day"
                           Style="border-radius: 0;" />
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       OnClick="@(() => GoToDate(DateTime.Today))"
                       Style="border-radius: 0;">Today</MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                           Variant="Variant.Outlined" Size="Size.Small"
                           Disabled="@(_date.Date >= DateTime.Today)"
                           OnClick="@(() => GoToDate(_date.AddDays(1)))"
                           title="Next day" aria-label="Next day"
                           Style="border-radius: 0;" />

            @if (_isExisting)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Delete"
                           Disabled="_isSaving" OnClick="DeleteAsync"
                           Style="border-radius: 0;">Delete</MudButton>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_isSaving" OnClick="SaveAsync"
                       Style="border-radius: 0;">
                @(_isExisting ? "Save" : "Create")
            </MudButton>
        </Actions>
    </ScreenHeader>

    @if (_validationError is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4" Style="border-radius: 0;">@_validationError</MudAlert>
    }

    <div class="lp-editor-grid">

        @* ---- manuscript column ---- *@
        <div style="position: relative;">
            @* The day set as an oversized folio numeral, as on a printed page.
               Decorative only, so it is hidden from assistive technology. *@
            <div class="lp-folio" aria-hidden="true">@_date.Day</div>

            <div class="lp-manuscript">
                <div class="lp-label lp-label-accent mb-4" style="display: flex; gap: 10px;">
                    <span>Folio @_date.Day</span>
                    <span style="color: var(--lp-faint);">@_date.ToString("MMMM").ToUpperInvariant()</span>
                </div>

                <input class="lp-title-input"
                       value="@_title"
                       @oninput="OnTitleInput"
                       maxlength="200"
                       placeholder="Give today a title…"
                       aria-label="Entry title" />

                <div class="lp-label mt-3" style="display: flex; gap: 16px; letter-spacing: 0.1em;">
                    @if (_isExisting)
                    {
                        <span>Created @_createdAt.ToString("d MMM HH:mm")</span>
                        <span>Updated @_updatedAt.ToString("d MMM HH:mm")</span>
                    }
                    else
                    {
                        <span>New entry</span>
                    }
                </div>

                <div class="lp-editor-panes mt-5">
                    <div>
                        <div class="lp-label mb-2">Write</div>
                        <MudTextField @bind-Value="_content"
                                      Variant="Variant.Outlined"
                                      Lines="16"
                                      Immediate="true"
                                      TextChanged="OnContentChanged"
                                      Placeholder="Markdown is supported: **bold**, *italics*, # headings, - lists, [links](url)"
                                      Style="border-radius: 0;" />
                    </div>

                    <div>
                        <div class="lp-label mb-2">Proof</div>
                        <div class="lp-card pa-4 markdown-preview">
                            @if (string.IsNullOrWhiteSpace(_content))
                            {
                                <span class="lp-label">Nothing to preview yet.</span>
                            }
                            else
                            {
                                @((MarkupString)Markdown.ToHtml(_content))
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ---- meta column ---- *@
        <div class="lp-stagger">

            <div class="lp-block mb-6">
                <div class="d-flex align-baseline justify-space-between mb-4">
                    <span class="lp-label">Mood</span>
                    <span class="lp-label" style="letter-spacing: 0.08em;">
                        @(_primaryMoodId > 0 ? "1 primary" : "required")
                    </span>
                </div>

                @foreach (var category in MoodCategories)
                {
                    <div class="mb-4">
                        <div class="lp-label d-flex align-center mb-2"
                             style="@($"gap:7px;letter-spacing:.06em;color:{LetterpressTheme.ColourFor(category)};")">
                            <span class="lp-swatch lp-swatch-round"
                                  style="@($"background:{LetterpressTheme.ColourFor(category)};")"></span>
                            @category.ToString().ToUpperInvariant()
                        </div>

                        <div class="d-flex flex-wrap" style="gap: 7px;">
                            @foreach (var mood in _moods.Where(m => m.Category == category))
                            {
                                var isPrimary = _primaryMoodId == mood.Id;
                                var isSecondary = _secondaryMoodIds.Contains(mood.Id);

                                <div class="lp-mood" style="@MoodChipStyle(mood, isPrimary, isSecondary)">
                                    <button type="button" class="lp-mood-main"
                                            @onclick="@(() => OnPrimaryMoodChanged(mood.Id))"
                                            title="@($"Set {mood.Name} as the primary mood")">
                                        @mood.Name
                                    </button>

                                    @if (!isPrimary)
                                    {
                                        @* The design marks a secondary mood with 2°. Making that
                                           marker the control keeps the look and gives keyboard
                                           users a way in, which right-click alone would not. *@
                                        <button type="button" class="lp-mood-second"
                                                @onclick="@(() => ToggleSecondary(mood.Id))"
                                                title="@($"{(isSecondary ? "Remove" : "Add")} {mood.Name} as a secondary mood")"
                                                style="@($"color:{(isSecondary ? MoodColour(mood) : "var(--lp-faint)")};")">
                                            2&deg;
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="lp-label" style="letter-spacing: 0.04em; line-height: 1.6;">
                    Pick one primary mood. Use 2&deg; to add up to two secondary moods.
                </div>
            </div>

            <div class="lp-block-light mb-6">
                <div class="lp-label mb-3">Category</div>
                <div class="d-flex flex-wrap" style="gap: 7px;">
                    @foreach (var category in _categories)
                    {
                        var selected = _categoryId == category.Id;

                        <button type="button" class="lp-pill"
                                style="@PillStyle(selected)"
                                @onclick="@(() => _categoryId = selected ? 0 : category.Id)">
                            @category.Name
                        </button>
                    }
                </div>
            </div>

            <div class="lp-block-light">
                <div class="lp-label mb-3">Tags</div>

                @if (_selectedTagIds.Count > 0)
                {
                    <div class="d-flex flex-wrap mb-3" style="gap: 7px;">
                        @foreach (var tag in _tags.Where(t => _selectedTagIds.Contains(t.Id)))
                        {
                            <span class="lp-tag-chip">
                                @tag.Name
                                <button type="button" class="lp-tag-remove"
                                        @onclick="@(() => RemoveTag(tag.Id))"
                                        aria-label="@($"Remove {tag.Name}")">&times;</button>
                            </span>
                        }
                    </div>
                }
                else
                {
                    <div class="lp-label mb-3" style="letter-spacing: 0.04em;">No tags yet.</div>
                }

                <div class="d-flex mb-4" style="gap: 7px;">
                    <MudTextField @bind-Value="_newTagName"
                                  Placeholder="Add custom tag…"
                                  Variant="Variant.Outlined"
                                  MaxLength="40"
                                  Immediate="true"
                                  Margin="Margin.Dense"
                                  OnKeyDown="OnNewTagKeyDown"
                                  Style="border-radius: 0;" />
                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                   Variant="Variant.Outlined"
                                   Disabled="@string.IsNullOrWhiteSpace(_newTagName)"
                                   OnClick="AddTagAsync"
                                   aria-label="Add tag"
                                   Style="border-radius: 0;" />
                </div>

                <div class="lp-label mb-2" style="letter-spacing: 0.12em;">Suggested</div>
                <div class="d-flex flex-wrap" style="gap: 7px;">
                    @foreach (var tag in _tags.Where(t => !_selectedTagIds.Contains(t.Id)).Take(SuggestedTagCount))
                    {
                        <button type="button" class="lp-pill" style="@PillStyle(false)"
                                @onclick="@(() => _selectedTagIds.Add(tag.Id))">
                            + @tag.Name
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Date segment of the route, as yyyy-MM-dd. Absent means today.</summary>
    [Parameter]
    public string? DateText { get; set; }

    private const int MaxSecondaryMoods = 2;

    private DateTime _date = DateTime.Today;
    private int _entryId;
    private bool _isExisting;
    private DateTime _createdAt;
    private DateTime _updatedAt;

    private string _title = string.Empty;
    private string _content = string.Empty;
    private int _primaryMoodId;
    private IReadOnlyCollection<int> _secondaryMoodIds = Array.Empty<int>();
    private int _categoryId;
    private HashSet<int> _selectedTagIds = new();
    private string _newTagName = string.Empty;

    private IReadOnlyList<Mood> _moods = Array.Empty<Mood>();
    private IReadOnlyList<Tag> _tags = Array.Empty<Tag>();
    private IReadOnlyList<Category> _categories = Array.Empty<Category>();

    private bool _isLoading = true;
    private bool _isSaving;
    private string? _validationError;
    private string? _fatalError;
    private int _liveWordCount;

    /// <summary>
    /// Runs on every navigation, including moving between days, so the form
    /// always reflects the date in the route.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _validationError = null;
        _fatalError = null;

        try
        {
            _date = ParseDate(DateText);

            if (_date > DateTime.Today)
            {
                _fatalError = "You cannot write an entry for a future date.";
                return;
            }

            _moods = await ReferenceData.GetMoodsAsync();
            _tags = await ReferenceData.GetTagsAsync();
            _categories = await ReferenceData.GetCategoriesAsync();

            await LoadEntryAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to open the editor for {Date}", _date);
            _fatalError = $"Could not open the editor: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>Loads the entry for the current date, or resets to a blank form.</summary>
    private async Task LoadEntryAsync()
    {
        var entry = await EntryService.GetByDateAsync(_date);

        if (entry is null)
        {
            _isExisting = false;
            _entryId = 0;
            _title = string.Empty;
            _content = string.Empty;
            _primaryMoodId = 0;
            _secondaryMoodIds = Array.Empty<int>();
            _categoryId = 0;
            _selectedTagIds = new HashSet<int>();
        }
        else
        {
            _isExisting = true;
            _entryId = entry.Id;
            _title = entry.Title;
            _content = entry.Content;
            _primaryMoodId = entry.PrimaryMoodId;
            _categoryId = entry.CategoryId ?? 0;
            _createdAt = entry.CreatedAt;
            _updatedAt = entry.UpdatedAt;

            _secondaryMoodIds = new[] { entry.SecondaryMoodOneId, entry.SecondaryMoodTwoId }
                .Where(id => id is > 0)
                .Select(id => id!.Value)
                .ToArray();

            var tagIds = await EntryService.GetTagIdsAsync(entry.Id);
            _selectedTagIds = tagIds.ToHashSet();
        }

        _liveWordCount = CountWords(_content);
    }

    /// <summary>Parses the route segment, falling back to today when absent or malformed.</summary>
    private static DateTime ParseDate(string? text) =>
        DateTime.TryParse(text, out var parsed) ? parsed.Date : DateTime.Today;

    private void GoToDate(DateTime date)
    {
        if (date.Date > DateTime.Today)
        {
            return;
        }

        Navigation.NavigateTo($"/write/{date:yyyy-MM-dd}");
    }

    private void OnContentChanged(string value)
    {
        _content = value;
        _liveWordCount = CountWords(value);
    }

    /// <summary>
    /// Changing the primary mood drops it from the secondary selection, since a
    /// mood cannot occupy two slots at once.
    /// </summary>
    private void OnPrimaryMoodChanged(int moodId)
    {
        _primaryMoodId = moodId;
        _secondaryMoodIds = _secondaryMoodIds.Where(id => id != moodId).ToArray();
    }

    /// <summary>
    /// Caps the secondary selection at two. Extra picks are dropped rather than
    /// silently accepted, with a message explaining why.
    /// </summary>
    private void OnSecondaryMoodsChanged(IReadOnlyCollection<int> values)
    {
        var accepted = values.Where(id => id != _primaryMoodId).ToArray();

        if (accepted.Length > MaxSecondaryMoods)
        {
            accepted = accepted.Take(MaxSecondaryMoods).ToArray();
            Snackbar.Add($"You can pick at most {MaxSecondaryMoods} secondary moods.", Severity.Info);
        }

        _secondaryMoodIds = accepted;
    }

    private async Task OnNewTagKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await AddTagAsync();
        }
    }

    /// <summary>
    /// Creates the tag if it is new, then selects it. An existing name resolves
    /// to the existing tag rather than creating a duplicate.
    /// </summary>
    private async Task AddTagAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTagName))
        {
            return;
        }

        try
        {
            var tag = await ReferenceData.GetOrCreateTagAsync(_newTagName);
            _tags = await ReferenceData.GetTagsAsync();
            _selectedTagIds.Add(tag.Id);
            _newTagName = string.Empty;

            Snackbar.Add($"Tag \"{tag.Name}\" added.", Severity.Success);
        }
        catch (ArgumentException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to add tag {TagName}", _newTagName);
            Snackbar.Add("Could not add that tag.", Severity.Error);
        }
    }

    private void RemoveTag(int tagId) => _selectedTagIds.Remove(tagId);

    private async Task SaveAsync()
    {
        _validationError = null;

        // Check here as well as in the service so the message appears beside the
        // form rather than as a thrown exception.
        if (string.IsNullOrWhiteSpace(_title))
        {
            _validationError = "Give your entry a title before saving.";
            return;
        }

        if (_primaryMoodId <= 0)
        {
            _validationError = "Choose a primary mood before saving.";
            return;
        }

        _isSaving = true;

        try
        {
            var secondaries = _secondaryMoodIds.Take(MaxSecondaryMoods).ToArray();

            var entry = new JournalEntry
            {
                Id = _entryId,
                EntryDate = _date,
                Title = _title,
                Content = _content,
                PrimaryMoodId = _primaryMoodId,
                SecondaryMoodOneId = secondaries.Length > 0 ? secondaries[0] : null,
                SecondaryMoodTwoId = secondaries.Length > 1 ? secondaries[1] : null,
                CategoryId = _categoryId > 0 ? _categoryId : null
            };

            var saved = await EntryService.SaveAsync(entry, _selectedTagIds);

            _entryId = saved.Id;
            _isExisting = true;
            _createdAt = saved.CreatedAt;
            _updatedAt = saved.UpdatedAt;
            _liveWordCount = saved.WordCount;

            Snackbar.Add("Entry saved.", Severity.Success);
        }
        catch (DuplicateEntryDateException ex)
        {
            _validationError = ex.Message;
        }
        catch (ArgumentException ex)
        {
            _validationError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save entry for {Date}", _date);
            _validationError = $"Could not save: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete this entry?",
            $"The entry for {_date:d MMMM yyyy} will be permanently removed.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        _isSaving = true;

        try
        {
            await EntryService.DeleteAsync(_entryId);
            Snackbar.Add("Entry deleted.", Severity.Success);
            await LoadEntryAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete entry {EntryId}", _entryId);
            _validationError = $"Could not delete: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>
    /// Mirrors the counting rule in EntryService so the live count matches what
    /// is ultimately stored.
    /// </summary>
    private static int CountWords(string? content) =>
        string.IsNullOrWhiteSpace(content)
            ? 0
            : content.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries)
                .Count(token => token.Any(char.IsLetterOrDigit));

    private const int SuggestedTagCount = 12;

    private static readonly MoodCategory[] MoodCategories =
        { MoodCategory.Positive, MoodCategory.Neutral, MoodCategory.Negative };

    private void OnTitleInput(ChangeEventArgs args) => _title = args.Value?.ToString() ?? string.Empty;

    private string MoodColour(Mood mood) => LetterpressTheme.ColourFor(mood.Name, mood.Category);

    /// <summary>
    /// A primary mood is filled with its own colour, a secondary outlined in it,
    /// and an unchosen mood carries only a hairline - so rank is legible without
    /// reading any label.
    /// </summary>
    private string MoodChipStyle(Mood mood, bool isPrimary, bool isSecondary)
    {
        var colour = MoodColour(mood);

        if (isPrimary)
        {
            return $"border:1px solid {colour};background:{colour};color:#121210;font-weight:600;";
        }

        return isSecondary
            ? $"border:1px solid {colour};background:{colour}22;"
            : "border:1px solid var(--lp-rule);background:transparent;";
    }

    private string PillStyle(bool selected) => selected
        ? "border:1px solid var(--lp-accent);background:var(--lp-accent);color:#FFFFFF;font-weight:600;"
        : "border:1px solid var(--lp-rule);background:transparent;color:var(--lp-muted);";

    /// <summary>
    /// Adds or removes a secondary mood, capped at two. An extra pick is refused
    /// with an explanation rather than silently dropped.
    /// </summary>
    private void ToggleSecondary(int moodId)
    {
        if (moodId == _primaryMoodId)
        {
            return;
        }

        var current = _secondaryMoodIds.ToList();

        if (current.Remove(moodId))
        {
            _secondaryMoodIds = current;
            return;
        }

        if (current.Count >= MaxSecondaryMoods)
        {
            Snackbar.Add($"You can pick at most {MaxSecondaryMoods} secondary moods.", Severity.Info);
            return;
        }

        current.Add(moodId);
        _secondaryMoodIds = current;
    }
}
