@page "/dashboard"
@inject IAnalyticsService Analytics
@inject NavigationManager Navigation
@inject ILogger<Dashboard> Logger

<PageTitle>Dashboard &middot; Reflect</PageTitle>

<ScreenHeader Title="Dashboard" Subtitle="@($"Insights across {_summary.EntryCount} entries")">
    <Actions>
        @foreach (var preset in Presets)
        {
            <MudButton Variant="@(_activePreset == preset.Label ? Variant.Filled : Variant.Outlined)"
                       Color="Color.Primary" Size="Size.Small"
                       OnClick="@(() => ApplyPresetAsync(preset.Label, preset.Days))">@preset.Label</MudButton>
        }
    </Actions>
</ScreenHeader>

@if (_loadFailure is not null)
{
    <MudAlert Severity="Severity.Error">@_loadFailure</MudAlert>
}
else
{
    @* The streaks are for the whole journal, not the selected range, so they go
       above the date picker rather than under it. *@
    <MudGrid Spacing="2" Class="mb-4">
        <MudItem xs="6" md="3">
            <StatCard Label="Current streak" Value="_streaks.CurrentStreak" Unit="days" Highlight="true" />
        </MudItem>
        <MudItem xs="6" md="3">
            <StatCard Label="Longest streak" Value="_streaks.LongestStreak" Unit="days" />
        </MudItem>
        <MudItem xs="6" md="3">
            <StatCard Label="Missed days" Value="_summary.MissedDays.Count" Unit="in range" />
        </MudItem>
        <MudItem xs="6" md="3">
            <StatCard Label="Average length" Value="@((int)Math.Round(_summary.AverageWords))" Unit="words" />
        </MudItem>
    </MudGrid>

    @if (_streaks.StreakAtRisk)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4"
                  Icon="@Icons.Material.Filled.LocalFireDepartment">
            Your @_streaks.CurrentStreak-day streak is still alive, but today is not written yet.
            <MudButton Variant="Variant.Text" Size="Size.Small" Href="/write">Write today's entry</MudButton>
        </MudAlert>
    }

    <div class="d-flex flex-wrap align-center gap-4 mb-6">
        <MudDateRangePicker Label="Range"
                            DateRange="_dateRange"
                            DateRangeChanged="OnRangeChanged"
                            Variant="Variant.Outlined"
                            MaxDate="DateTime.Today"
                            Margin="Margin.Dense"
                            Style="max-width: 320px;" />
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @_summary.EntryCount of @_summary.EligibleDays days written
        </MudText>
    </div>

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-6" />
    }
    else if (_summary.EntryCount == 0)
    {
        <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined">
            No entries in this range, so there is nothing to chart yet.
        </MudAlert>
    }
    else
    {
        <MudGrid Class="mb-2">
            <MudItem xs="12" md="6">
                <MudCard Style="height: 100%;">
                    <MudCardContent>
                        <MudText Typo="Typo.h6">Mood distribution</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                            Primary mood by sentiment
                        </MudText>

                        @foreach (var share in _summary.MoodDistribution)
                        {
                            <div class="d-flex align-center justify-space-between">
                                <MudText Typo="Typo.body2">@share.Category</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @share.Count (@share.Percentage%)
                                </MudText>
                            </div>
                            <MudProgressLinear Value="@share.Percentage" Size="Size.Medium" Class="mb-3"
                                               Color="@CategoryColour(share.Category)" />
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCard Style="height: 100%;">
                    <MudCardContent>
                        <MudText Typo="Typo.h6">Most frequent mood</MudText>

                        @if (_summary.MostFrequentMood is { } top)
                        {
                            <div class="d-flex align-center gap-2 my-3">
                                <span class="mood-dot"
                                      style="@($"width:16px;height:16px;background:{AppTheme.ColourFor(top.Name, top.Category)};")"></span>
                                <MudText Typo="Typo.h5">@top.Name</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @top.Count of @_summary.EntryCount days
                                &middot; @(Math.Round(top.Count * 100.0 / _summary.EntryCount))%
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-3">
                                No moods recorded in range.
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudCard Class="mb-4">
            <MudCardContent>
                <MudText Typo="Typo.h6">Word-count trend</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Average words per entry, @GroupingLabel &middot; @_summary.TotalWords words in total
                </MudText>

                @if (_summary.WordCountTrend.Count < 2)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Not enough entries in this range to show a trend yet.
                    </MudText>
                }
                else
                {
                    @* MudChart wants the numbers as a double[] and the labels as a
                       string[], so the trend gets pulled apart into two arrays. *@
                    <MudChart ChartType="ChartType.Line"
                              ChartSeries="@TrendSeries"
                              ChartLabels="@TrendLabels"
                              Width="100%"
                              Height="260px" />
                }
            </MudCardContent>
        </MudCard>

        <MudGrid Class="mb-2">
            <MudItem xs="12" md="6">
                <MudCard Style="height: 100%;">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="mb-3">Most used tags</MudText>

                        @if (_summary.TopTags.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                No tags used in this range.
                            </MudText>
                        }
                        else
                        {
                            var mostUsed = _summary.TopTags.Max(t => t.Count);

                            @foreach (var tag in _summary.TopTags)
                            {
                                <div class="d-flex align-center justify-space-between">
                                    <MudText Typo="Typo.body2">@tag.Name</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@tag.Count</MudText>
                                </div>
                                <MudProgressLinear Value="@Percent(tag.Count, mostUsed)"
                                                   Color="Color.Primary" Class="mb-3" />
                            }
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCard Style="height: 100%;">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="mb-3">Entries by category</MudText>

                        @if (_summary.CategoryBreakdown.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                No categories in this range.
                            </MudText>
                        }
                        else
                        {
                            var biggest = _summary.CategoryBreakdown.Max(c => c.Count);

                            @foreach (var category in _summary.CategoryBreakdown)
                            {
                                <div class="d-flex align-center justify-space-between">
                                    <MudText Typo="Typo.body2">@category.Name</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@category.Count</MudText>
                                </div>
                                <MudProgressLinear Value="@Percent(category.Count, biggest)"
                                                   Color="Color.Primary" Class="mb-3" />
                            }
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        @if (_summary.MissedDays.Count > 0)
        {
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6">Missed days</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        @_summary.MissedDays.Count of @_summary.EligibleDays days have no entry
                    </MudText>

                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var day in _summary.MissedDays.OrderByDescending(d => d).Take(MissedDaysShown))
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                       OnClick="@(() => OpenDate(day))">
                                @day.ToString("d MMM")
                            </MudButton>
                        }
                    </div>

                    @if (_summary.MissedDays.Count > MissedDaysShown)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-3">
                            Showing the @MissedDaysShown most recent.
                        </MudText>
                    }
                </MudCardContent>
            </MudCard>
        }
    }
}

@code {
    private const int MissedDaysShown = 21;

    private static readonly (string Label, int Days)[] Presets =
    {
        ("7 days", 7),
        ("30 days", 30),
        ("90 days", 90),
        ("1 year", 365)
    };

    private StreakSummary _streaks = StreakSummary.Empty;
    private AnalyticsSummary _summary = new();
    private DateRange? _dateRange;
    private string _activePreset = "30 days";

    private bool _isLoading = true;
    private string? _loadFailure;


    private string GroupingLabel => _summary.Grouping switch
    {
        TrendGrouping.Daily => "by day",
        TrendGrouping.Weekly => "by week",
        _ => "by month"
    };

    protected override async Task OnInitializedAsync()
    {
        _dateRange = new DateRange(DateTime.Today.AddDays(-29), DateTime.Today);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;

        try
        {
            _streaks = await Analytics.GetStreaksAsync();

            var from = _dateRange?.Start ?? DateTime.Today.AddDays(-29);
            var to = _dateRange?.End ?? DateTime.Today;

            _summary = await Analytics.GetSummaryAsync(from, to);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the dashboard");
            _loadFailure = $"Could not load the dashboard: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnRangeChanged(DateRange? range)
    {
        _dateRange = range;
        _activePreset = string.Empty;
        await LoadAsync();
    }

    private async Task ApplyPresetAsync(string label, int days)
    {
        _activePreset = label;
        _dateRange = new DateRange(DateTime.Today.AddDays(-(days - 1)), DateTime.Today);
        await LoadAsync();
    }

    private static Color CategoryColour(MoodCategory category) => category switch
    {
        MoodCategory.Positive => Color.Success,
        MoodCategory.Negative => Color.Error,
        _ => Color.Info
    };

    private void OpenDate(DateTime date) => Navigation.NavigateTo($"/write/{date:yyyy-MM-dd}");

    // Width of a bar as a percentage of the biggest one in the list.
    private static double Percent(int value, int max) =>
        max <= 0 ? 0 : Math.Round(value * 100.0 / max, 1);

    // MudChart takes one series of doubles plus the labels for the X axis.
    private List<ChartSeries<double>> TrendSeries =>
        new()
        {
            new ChartSeries<double>
            {
                Name = "Average words",
                Data = _summary.WordCountTrend.Select(point => point.AverageWords).ToArray()
            }
        };

    private string[] TrendLabels =>
        _summary.WordCountTrend.Select(point => point.Label).ToArray();

}
