@page "/export"
@inject IJournalExporter Exporter
@inject IEntryService EntryService
@inject ISnackbar Snackbar
@inject ILogger<Export> Logger

<PageTitle>Export &middot; Reflect</PageTitle>

<ScreenHeader Title="Export"
              Subtitle="Save a range of entries as a PDF you can keep, print or share" />

<div class="lp-stagger" style="max-width: 660px;">

    <div class="lp-block mb-6">
        <div class="d-flex align-center mb-5" style="gap: 12px;">
            <span class="lp-monogram" style="width: 38px; height: 38px;">
                <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" />
            </span>
            <div>
                <MudText Typo="Typo.h6">Export journal to PDF</MudText>
                <div class="lp-label mt-1" style="letter-spacing: 0.04em;">
                    A printable copy of your entries within a date range
                </div>
            </div>
        </div>

        <div class="lp-label mb-2">Range</div>
        <MudDateRangePicker DateRange="_dateRange"
                            DateRangeChanged="OnRangeChangedAsync"
                            Variant="Variant.Outlined"
                            MaxDate="DateTime.Today"
                            Margin="Margin.Dense"
                            Class="mb-4"
                            Style="max-width: 340px; border-radius: 0;" />

        <div class="d-flex flex-wrap mb-5" style="gap: 7px;">
            @foreach (var preset in Presets)
            {
                <button type="button" class="lp-pill" style="@PillStyle()"
                        @onclick="@(() => ApplyPresetAsync(preset.Days))">@preset.Label</button>
            }
            <button type="button" class="lp-pill" style="@PillStyle()"
                    @onclick="ApplyEverythingAsync">Everything</button>
        </div>

        @* The count is set as a figure, so the size of what is about to be
           written is legible before committing to a file. *@
        <div class="lp-block-light mb-5 d-flex align-baseline" style="gap: 10px;">
            @if (_isCounting)
            {
                <span class="lp-label">Counting…</span>
            }
            else
            {
                <span class="lp-figure" style="font-size: 40px;">@_entriesInRange</span>
                <span class="lp-label">
                    @(_entriesInRange == 1 ? "entry will be exported" : "entries will be exported")
                </span>
            }
        </div>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PictureAsPdf"
                   Disabled="@(_isExporting || _entriesInRange == 0)"
                   OnClick="ExportAsync"
                   Style="border-radius: 0; padding: 11px 18px; font-size: 0.66rem; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 600;">
            @(_isExporting ? "Exporting…" : "Export PDF")
        </MudButton>

        @if (_entriesInRange == 0 && !_isCounting)
        {
            <div class="lp-label mt-3" style="letter-spacing: 0.04em;">
                No entries in this range, so there would be nothing to export.
            </div>
        }
    </div>

    @if (_lastExportPath is not null)
    {
        <div class="lp-block-light mb-6">
            <div class="lp-label lp-label-accent mb-2">Saved</div>
            <div class="lp-label mb-3" style="letter-spacing: 0.02em; word-break: break-all; text-transform: none;">
                @_lastExportPath
            </div>
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.OpenInNew"
                       OnClick="OpenLastExportAsync"
                       Style="border-radius: 0;">Open it</MudButton>
        </div>
    }

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Style="border-radius: 0;">@_error</MudAlert>
    }
</div>

@code {
    private static readonly (string Label, int Days)[] Presets =
    {
        ("30 days", 30),
        ("90 days", 90),
        ("This year", 365)
    };

    private DateRange? _dateRange;
    private int _entriesInRange;
    private bool _isCounting = true;
    private bool _isExporting;
    private string? _lastExportPath;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _dateRange = new DateRange(DateTime.Today.AddDays(-29), DateTime.Today);
        await CountAsync();
    }

    /// <summary>
    /// Counts what would be exported, so the range can be judged before
    /// committing to writing a file.
    /// </summary>
    private async Task CountAsync()
    {
        _isCounting = true;
        _error = null;

        try
        {
            var from = _dateRange?.Start ?? DateTime.Today;
            var to = _dateRange?.End ?? DateTime.Today;
            var entries = await EntryService.GetRangeAsync(from, to);
            _entriesInRange = entries.Count;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to count entries for export");
            _error = $"Could not read the journal: {ex.Message}";
            _entriesInRange = 0;
        }
        finally
        {
            _isCounting = false;
        }
    }

    private async Task OnRangeChangedAsync(DateRange? range)
    {
        _dateRange = range;
        _lastExportPath = null;
        await CountAsync();
    }

    private async Task ApplyPresetAsync(int days)
    {
        _dateRange = new DateRange(DateTime.Today.AddDays(-(days - 1)), DateTime.Today);
        _lastExportPath = null;
        await CountAsync();
    }

    /// <summary>Widens the range to cover the whole journal.</summary>
    private async Task ApplyEverythingAsync()
    {
        _dateRange = new DateRange(new DateTime(2000, 1, 1), DateTime.Today);
        _lastExportPath = null;
        await CountAsync();
    }

    private async Task ExportAsync()
    {
        _isExporting = true;
        _error = null;
        _lastExportPath = null;

        try
        {
            var from = _dateRange?.Start ?? DateTime.Today;
            var to = _dateRange?.End ?? DateTime.Today;

            var directory = ResolveExportDirectory();
            Directory.CreateDirectory(directory);

            var path = Path.Combine(directory, Exporter.SuggestFileName(from, to));

            // Written to a stream the page owns, so a failure part-way leaves a
            // partial file rather than a half-written one somewhere unexpected.
            await using (var stream = File.Create(path))
            {
                await Exporter.ExportRangeAsync(from, to, stream);
            }

            _lastExportPath = path;
            Snackbar.Add($"Exported {_entriesInRange} entries.", Severity.Success);
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogError(ex, "Export denied by the file system");
            _error = "Could not write there. Check the folder is writable.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Export failed");
            _error = $"Export failed: {ex.Message}";
        }
        finally
        {
            _isExporting = false;
        }
    }

    /// <summary>
    /// Picks somewhere sensible to write. Documents on desktop, where the user
    /// can find the file; the app's own data directory on platforms that do not
    /// grant access to a shared documents folder.
    /// </summary>
    private static string ResolveExportDirectory()
    {
        var documents = Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments);

        return string.IsNullOrWhiteSpace(documents)
            ? Path.Combine(FileSystem.AppDataDirectory, "Exports")
            : Path.Combine(documents, "Reflect");
    }

    private async Task OpenLastExportAsync()
    {
        if (_lastExportPath is null)
        {
            return;
        }

        try
        {
            await Launcher.OpenAsync(new OpenFileRequest
            {
                File = new ReadOnlyFile(_lastExportPath)
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not open the exported file");
            Snackbar.Add("Could not open it. The file is still saved at the path shown.", Severity.Warning);
        }
    }

    private static string PillStyle() =>
        "border:1px solid var(--lp-rule);background:transparent;color:var(--lp-muted);";
}
