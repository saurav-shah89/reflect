@* The heading every page starts with. Put in its own component so I don't have
   to repeat the same markup on seven pages. *@
<div class="d-flex align-center justify-space-between flex-wrap gap-3 mb-2">
    <div>
        <MudText Typo="Typo.h4">@Title</MudText>

        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Subtitle</MudText>
        }
    </div>

    @if (Actions is not null)
    {
        <div class="d-flex align-center flex-wrap gap-2">
            @Actions
        </div>
    }
</div>

<MudDivider Class="mb-6" />

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Subtitle { get; set; }

    // Buttons shown on the right of the heading.
    [Parameter] public RenderFragment? Actions { get; set; }
}
