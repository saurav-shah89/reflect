@inject ISettingsService Settings
@inject AppLockState LockState
@inject ILogger<LockScreen> Logger

@* Shown instead of the whole app while the journal is locked. Nothing behind it
   is rendered, so entry content never reaches the page before unlocking. *@
<div class="lock-screen">
    <MudPaper Class="lock-panel pa-6" Elevation="3">

        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h5" Class="mt-2">Reflect</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Enter your passphrase to unlock
        </MudText>

        <MudTextField @bind-Value="_passphrase"
                      Label="Passphrase or PIN"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Immediate="true"
                      OnKeyDown="OnKeyDown"
                      Disabled="_isChecking"
                      Class="mb-4" />

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Disabled="@(_isChecking || string.IsNullOrEmpty(_passphrase))"
                   OnClick="UnlockAsync">
            @(_isChecking ? "Checking…" : "Unlock")
        </MudButton>

        <MudText Typo="Typo.caption" Class="d-block mt-4">
            There is no recovery. If you forget it, the journal cannot be opened.
        </MudText>
    </MudPaper>
</div>

@code {
    private string _passphrase = string.Empty;
    private string? _error;
    private bool _isChecking;
    private int _failedAttempts;

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await UnlockAsync();
        }
    }

    private async Task UnlockAsync()
    {
        if (string.IsNullOrEmpty(_passphrase))
        {
            return;
        }

        _isChecking = true;
        _error = null;

        try
        {
            if (await Settings.VerifyPassphraseAsync(_passphrase))
            {
                _passphrase = string.Empty;
                _failedAttempts = 0;
                LockState.Unlock();
                return;
            }

            _failedAttempts++;
            _passphrase = string.Empty;

            // Deliberately vague: naming which part was wrong would help someone
            // guessing. The count is shown only as a nudge for the owner.
            _error = _failedAttempts == 1
                ? "That passphrase is not correct."
                : $"That passphrase is not correct. {_failedAttempts} failed attempts.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unlock check failed");
            _error = "Could not check the passphrase. Try again.";
        }
        finally
        {
            _isChecking = false;
        }
    }
}
