@inject ISettingsService Settings
@inject AppLockState LockState
@inject ILogger<LockScreen> Logger

@* Shown in place of the whole app while the journal is locked. Nothing behind
   it is rendered, so entry content never reaches the DOM before unlocking. *@
<div class="lock-screen lp-grain">
    <div class="lock-panel lp-stagger">

        <div class="d-flex flex-column align-center mb-6">
            <div class="lp-monogram" style="width: 78px; height: 78px; font-size: 44px;">R</div>
            <div class="lp-display lp-ink-in mt-4" style="font-size: 46px; line-height: 1;">Reflect</div>
            <div class="lp-label mt-3">Enter your passphrase to unlock</div>
        </div>

        <MudTextField @bind-Value="_passphrase"
                      Label="Passphrase or PIN"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Immediate="true"
                      OnKeyDown="OnKeyDown"
                      Disabled="_isChecking"
                      Class="mb-4"
                      Style="border-radius: 0;" />

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" Style="border-radius: 0;">
                @_error
            </MudAlert>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Disabled="@(_isChecking || string.IsNullOrEmpty(_passphrase))"
                   OnClick="UnlockAsync"
                   Style="border-radius: 0; padding: 12px; font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 600;">
            @(_isChecking ? "Checking…" : "Unlock")
        </MudButton>

        <div class="lp-label mt-6" style="font-size: 0.55rem; line-height: 1.7;">
            There is no recovery. If you forget it, the journal cannot be opened.
        </div>
    </div>
</div>

@code {
    private string _passphrase = string.Empty;
    private string? _error;
    private bool _isChecking;
    private int _failedAttempts;

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await UnlockAsync();
        }
    }

    private async Task UnlockAsync()
    {
        if (string.IsNullOrEmpty(_passphrase))
        {
            return;
        }

        _isChecking = true;
        _error = null;

        try
        {
            if (await Settings.VerifyPassphraseAsync(_passphrase))
            {
                _passphrase = string.Empty;
                _failedAttempts = 0;
                LockState.Unlock();
                return;
            }

            _failedAttempts++;
            _passphrase = string.Empty;

            // Deliberately vague: naming which part was wrong would help someone
            // guessing. The count is shown only as a nudge for the owner.
            _error = _failedAttempts == 1
                ? "That passphrase is not correct."
                : $"That passphrase is not correct. {_failedAttempts} failed attempts.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unlock check failed");
            _error = "Could not check the passphrase. Try again.";
        }
        finally
        {
            _isChecking = false;
        }
    }
}
