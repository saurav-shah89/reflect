@inherits LayoutComponentBase
@implements IDisposable
@using Reflect.Theme
@inject ISettingsService Settings
@inject AppLockState LockState
@inject ILogger<MainLayout> Logger

@* MudBlazor providers must sit above the routed content: popovers, dialogs and
   snackbars render into these, so components anywhere in the tree can raise them. *@
<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* The wrapper carries the dark-mode signal for the letterpress variables. It has
   to be our own class rather than MudBlazor's, because the lock screen renders
   outside MudLayout and would otherwise miss it. *@
<div class="lp-root @(_isDarkMode ? "lp-dark" : null)">
    @if (_isStarting)
    {
        @* Nothing is rendered until the lock state is known, so a locked journal
           never flashes its contents on the way to the lock screen. *@
        <div class="lock-screen">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else if (_isLocked)
    {
        <LockScreen />
    }
    else
    {
        <MudLayout Class="lp-grain">
            <MudDrawer Open="true" Variant="DrawerVariant.Persistent" Elevation="0"
                       ClipMode="DrawerClipMode.Never">
                <NavMenu IsDarkMode="_isDarkMode"
                         IsLockConfigured="_isLockConfigured"
                         OnToggleTheme="ToggleThemeAsync"
                         OnLockNow="LockNow" />
            </MudDrawer>

            <MudMainContent Class="pa-0">
                <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
                    @Body
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    }
</div>

@code {
    private readonly MudTheme _theme = LetterpressTheme.Build();

    private bool _isDarkMode;
    private bool _isStarting = true;
    private bool _isLockConfigured;

    private bool _isLocked => _isLockConfigured && !LockState.IsUnlocked;

    protected override void OnInitialized()
    {
        LockState.Changed += OnLockChanged;
        LockState.ConfigurationChanged += OnLockConfigurationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLockConfigured = await Settings.IsLockEnabledAsync();
            _isDarkMode = await Settings.GetThemeAsync() == "dark";
        }
        catch (Exception ex)
        {
            // Failing open here would expose a locked journal, so treat an
            // unreadable settings row as locked and let the unlock screen
            // surface the problem.
            Logger.LogError(ex, "Could not read settings at startup");
            _isLockConfigured = true;
        }
        finally
        {
            _isStarting = false;
        }
    }

    private void OnLockChanged() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// Re-reads whether a lock is configured, so the sidebar's lock control
    /// appears or disappears as soon as the credential is set or removed.
    /// </summary>
    private void OnLockConfigurationChanged() => InvokeAsync(async () =>
    {
        _isLockConfigured = await Settings.IsLockEnabledAsync();
        StateHasChanged();
    });

    private void LockNow() => LockState.Lock();

    /// <summary>Flips the theme and persists it, so the choice survives a restart.</summary>
    private async Task ToggleThemeAsync()
    {
        _isDarkMode = !_isDarkMode;

        try
        {
            await Settings.SetThemeAsync(_isDarkMode ? "dark" : "light");
        }
        catch (Exception ex)
        {
            // The theme has already changed on screen; losing the preference is
            // worth a log but not worth interrupting the user.
            Logger.LogError(ex, "Could not persist the theme preference");
        }
    }

    public void Dispose()
    {
        LockState.Changed -= OnLockChanged;
        LockState.ConfigurationChanged -= OnLockConfigurationChanged;
    }
}
