@inherits LayoutComponentBase
@implements IDisposable
@using Reflect.Theme
@inject ISettingsService Settings
@inject AppLockState LockState
@inject ILogger<MainLayout> Logger

@* The MudBlazor providers have to go above the page content, because popovers,
   dialogs and snackbars are rendered into them. *@
<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (_isStarting)
{
    @* Nothing is rendered until the lock state is known, so a locked journal
       never flashes its contents on the way to the lock screen. *@
    <div class="lock-screen">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </div>
}
else if (_isLocked)
{
    <LockScreen />
}
else
{
    <MudLayout>
        <MudAppBar Elevation="1">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                           OnClick="ToggleDrawer" aria-label="Toggle the menu" />
            <MudText Typo="Typo.h6" Class="ml-2">Reflect</MudText>

            <MudSpacer />

            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           OnClick="ToggleThemeAsync"
                           aria-label="Switch between light and dark mode"
                           title="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")" />

            @if (_isLockConfigured)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Lock"
                               Color="Color.Inherit"
                               OnClick="LockNow"
                               aria-label="Lock the journal"
                               title="Lock the journal" />
            }
        </MudAppBar>

        <MudDrawer @bind-Open="_isDrawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always">
            <NavMenu />
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.Large" Class="my-6">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}

@code {
    private readonly MudTheme _theme = AppTheme.Build();

    private bool _isDarkMode;
    private bool _isDrawerOpen = true;
    private bool _isStarting = true;
    private bool _isLockConfigured;

    private bool _isLocked => _isLockConfigured && !LockState.IsUnlocked;

    protected override void OnInitialized()
    {
        LockState.Changed += OnLockChanged;
        LockState.ConfigurationChanged += OnLockConfigurationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLockConfigured = await Settings.IsLockEnabledAsync();
            _isDarkMode = await Settings.GetThemeAsync() == "dark";
        }
        catch (Exception ex)
        {
            // Failing open here would expose a locked journal, so treat an
            // unreadable settings row as locked and let the unlock screen
            // surface the problem.
            Logger.LogError(ex, "Could not read settings at startup");
            _isLockConfigured = true;
        }
        finally
        {
            _isStarting = false;
        }
    }

    private void ToggleDrawer() => _isDrawerOpen = !_isDrawerOpen;

    private void OnLockChanged() => InvokeAsync(StateHasChanged);

    // Re-reads whether a passphrase exists, so the lock button in the app bar
    // shows up or disappears straight after it's set or removed.
    private void OnLockConfigurationChanged() => InvokeAsync(async () =>
    {
        _isLockConfigured = await Settings.IsLockEnabledAsync();
        StateHasChanged();
    });

    private void LockNow() => LockState.Lock();

    // Flips the theme and saves it, so the choice survives a restart.
    private async Task ToggleThemeAsync()
    {
        _isDarkMode = !_isDarkMode;

        try
        {
            await Settings.SetThemeAsync(_isDarkMode ? "dark" : "light");
        }
        catch (Exception ex)
        {
            // The theme has already changed on screen; losing the preference is
            // worth a log but not worth interrupting the user.
            Logger.LogError(ex, "Could not persist the theme preference");
        }
    }

    public void Dispose()
    {
        LockState.Changed -= OnLockChanged;
        LockState.ConfigurationChanged -= OnLockConfigurationChanged;
    }
}
