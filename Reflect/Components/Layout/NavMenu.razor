@inject IAnalyticsService Analytics
@inject ILogger<NavMenu> Logger

@* The sidebar: a button for today's entry, the page links, and the streak at
   the bottom. *@
<div class="d-flex flex-column" style="height: 100%;">

    <div class="pa-4">
        <MudButton Href="/write"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   StartIcon="@Icons.Material.Filled.Add">
            Today's entry
        </MudButton>
    </div>

    <MudNavMenu>
        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Today">Today</MudNavLink>
        <MudNavLink Href="write" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Edit">Write</MudNavLink>
        <MudNavLink Href="calendar" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CalendarMonth">Calendar</MudNavLink>
        <MudNavLink Href="journal" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MenuBook">Timeline</MudNavLink>
        <MudNavLink Href="dashboard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.InsertChart">Dashboard</MudNavLink>
        <MudNavLink Href="export" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PictureAsPdf">Export</MudNavLink>
        <MudNavLink Href="settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
    </MudNavMenu>

    <MudSpacer />

    <div class="pa-4">
        <MudDivider Class="mb-3" />
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment"
                     Color="@(_currentStreak > 0 ? Color.Primary : Color.Default)"
                     Size="Size.Small" />
            <MudText Typo="Typo.body2">
                @_currentStreak @(_currentStreak == 1 ? "day" : "days") in a row
            </MudText>
        </div>
    </div>
</div>

@code {
    private int _currentStreak;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var streaks = await Analytics.GetStreaksAsync();
            _currentStreak = streaks.CurrentStreak;
        }
        catch (Exception ex)
        {
            // The streak is only shown in the sidebar; failing to read it must
            // not stop the rest of the app rendering.
            Logger.LogError(ex, "Could not read the current streak for the sidebar");
        }
    }
}
